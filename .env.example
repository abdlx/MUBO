# Absolute host path to the folder containing your music.
MUSIC_PATH=/srv/music

# Public port for Mubo.
MUBO_PORT=3000

# How quickly newly added/removed files appear, in milliseconds.
LIBRARY_SCAN_INTERVAL_MS=15000

# Change both before exposing the recommendation stack outside your private network.
POSTGRES_PASSWORD=mubo-local-only
RECOMMENDATION_API_KEY=local-development-key
RECOMMENDATION_USER_ID=local-listener
